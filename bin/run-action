#!/bin/bash
# Runs one named widget action and reports {ok, output} as JSON, so the QML
# side only ever spawns one well-known command per button instead of
# constructing omarchy-backup argv itself.
set -uo pipefail
umask 077

readonly ACTION_OUTPUT_CAPTURE_MAX_BYTES=16384
readonly ACTION_OUTPUT_FORWARD_MAX_BYTES=4096
readonly ACTION_TIMEOUT_SECONDS=900
readonly STATE_MAX_BYTES=65536

CAPTURE_OUTPUT=""
CAPTURE_CODE=1

capture_bounded() {
  local deadline="$1"
  shift
  local tmp size
  local -a pipeline_status
  tmp="$(mktemp)" || return 1
  timeout --signal=TERM --kill-after=5s "${deadline}s" "$@" < /dev/null 2>&1 \
    | head -c "$((ACTION_OUTPUT_CAPTURE_MAX_BYTES + 1))" > "$tmp"
  pipeline_status=("${PIPESTATUS[@]}")
  CAPTURE_CODE="${pipeline_status[0]}"
  size="$(stat -c '%s' -- "$tmp" 2>/dev/null || echo "$((ACTION_OUTPUT_CAPTURE_MAX_BYTES + 1))")"
  if [ "$size" -gt "$ACTION_OUTPUT_CAPTURE_MAX_BYTES" ]; then
    CAPTURE_OUTPUT="Action stopped: CLI output exceeded the ${ACTION_OUTPUT_CAPTURE_MAX_BYTES}-byte safety limit."
    CAPTURE_CODE=1
  elif [ "$CAPTURE_CODE" -eq 124 ] || [ "$CAPTURE_CODE" -eq 137 ]; then
    CAPTURE_OUTPUT="Action stopped after the ${deadline}-second safety deadline."
    CAPTURE_CODE=1
  else
    CAPTURE_OUTPUT="$(tail -c "$ACTION_OUTPUT_FORWARD_MAX_BYTES" -- "$tmp")"
  fi
  rm -f -- "$tmp"
}

CLI="$(command -v omarchy-backup || true)"
if [ -z "$CLI" ]; then
  jq -n '{ok:false, output:"omarchy-backup is not installed / not on PATH"}'
  exit 0
fi

action="${1:-}"
shift || true

STATE_FILE="$HOME/.local/share/omarchy-backup/state.json"
SNAPSHOTS_DIR="$HOME/.local/share/omarchy-backup/snapshots"

run() {
  local ok=false
  capture_bounded "$ACTION_TIMEOUT_SECONDS" "$@"
  [ "$CAPTURE_CODE" -eq 0 ] && ok=true
  jq -n --arg out "$CAPTURE_OUTPUT" --argjson ok "$ok" '{ok:$ok, output:$out}'
}

latest_snapshot_name() {
  local size
  size="$(stat -c '%s' -- "$STATE_FILE" 2>/dev/null || echo 0)"
  [ "$size" -le "$STATE_MAX_BYTES" ] || return 1
  timeout --signal=TERM --kill-after=1s 2s \
    jq -r '.snapshots | if type == "array" and length <= 3 then sort_by(.created_at) | reverse | .[0].name // empty else empty end' \
      "$STATE_FILE" 2>/dev/null
}

case "$action" in
  snapshot)
    capture_bounded "$ACTION_TIMEOUT_SECONDS" "$CLI" snapshot
    out="$CAPTURE_OUTPUT"
    code="$CAPTURE_CODE"
    name="$(printf '%s\n' "$out" | tail -n1)"
    if [ $code -eq 0 ] && [ -n "$name" ] && [ -f "$SNAPSHOTS_DIR/$name/manifest.json" ]; then
      manifest="$SNAPSHOTS_DIR/$name/manifest.json"
      large="$(jq '.skipped_large_files | length' "$manifest" 2>/dev/null || echo 0)"
      secret="$(jq '.skipped_secret_files | length' "$manifest" 2>/dev/null || echo 0)"
      msg="Created '$name'"
      [ "$large" -gt 0 ] 2>/dev/null && msg="$msg -- $large file(s) skipped for being over the size cap"
      [ "$secret" -gt 0 ] 2>/dev/null && msg="$msg -- $secret file(s) skipped as likely secrets"
      jq -n --arg out "$msg" '{ok:true, output:$out}'
    else
      ok=false
      [ "$code" -eq 0 ] && ok=true
      jq -n --arg out "$out" --argjson ok "$ok" '{ok:$ok, output:$out}'
    fi
    ;;
  push-latest)
    latest="$(latest_snapshot_name)"
    if [ -z "$latest" ]; then
      jq -n '{ok:false, output:"No local snapshot to push yet -- run Snapshot first."}'
    else
      run "$CLI" push "$latest"
    fi
    ;;
  mark-baseline-latest)
    latest="$(latest_snapshot_name)"
    if [ -z "$latest" ]; then
      jq -n '{ok:false, output:"No local snapshot yet -- run Snapshot first."}'
    else
      capture_bounded "$ACTION_TIMEOUT_SECONDS" "$CLI" baseline "$latest"
      ok=false
      [ "$CAPTURE_CODE" -eq 0 ] && ok=true
      jq -n --arg out "Marked '$latest' as baseline." --argjson ok "$ok" \
        --arg raw "$CAPTURE_OUTPUT" '{ok:$ok, output:(if $ok then $out else $raw end)}'
    fi
    ;;
  doctor) run "$CLI" doctor ;;
  install-timers) run "$CLI" timers install ;;
  uninstall-timers) run "$CLI" timers uninstall ;;
  *) jq -n --arg a "$action" '{ok:false, output:("Unknown action: " + $a)}' ;;
esac
